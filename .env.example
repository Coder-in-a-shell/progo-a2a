# ==============================================================================
# ProGoA2A Environment Variables (Local Development Example)
# WARNING: Use fake/local placeholder values only. Never commit real credentials.
# ==============================================================================

# Storage Configuration
# Set STORAGE_BACKEND to "postgres" for PostgreSQL or "memory" for in-memory storage.
STORAGE_BACKEND=postgres
# Docker Compose service hostname; use localhost only for a database published to the host.
DATABASE_URL=postgres://postgres:postgres_dev_password@postgres:5432/progo_a2a?sslmode=disable
MIGRATE_ON_START=true

# Local PostgreSQL Container Credentials (used by docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password
POSTGRES_DB=progo_a2a

# Inbound Proxy API Keys (for client authentication when security is enabled)
ADMIN_API_KEY=admin-local-key
ANALYST_API_KEY=analyst-local-key

# Downstream Agent Adapter Credentials (placeholders for config/progo-a2a.example.yaml)
LANGGRAPH_API_KEY=local-langgraph-key
CREWAI_API_TOKEN=local-crewai-token
AUTOGEN_API_KEY=local-autogen-key
OPENAI_API_KEY=local-openai-key
ENTERPRISE_AUTH_TOKEN=local-enterprise-token

# Optional Integration Test DSN (used by `go test -race ./...` for PostgreSQL integration tests)
# POSTGRES_TEST_DSN=postgres://postgres:postgres_test_password@localhost:5432/progo_test?sslmode=disable
